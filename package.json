{
  "name": "unifi-mcp",
  "version": "0.2.0",
  "description": "MCP server for UniFi Network: query devices and clients, manage zone-based firewall policies, block/unblock clients.",
  "type": "module",
  "bin": {
    "unifi-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "check": "node dist/check.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --import tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "undici": "^8.11.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0"
  }
}
