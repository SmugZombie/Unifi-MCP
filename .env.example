# Console address (your UDM / UCG / Cloud Key)
UNIFI_HOST=https://192.168.1.1

# API key: UniFi Network > Settings > Control Plane > Integrations > Create API Key
UNIFI_API_KEY=

# Optional: local-only admin account. Used for client block/unblock if the
# console rejects the API key on the internal API.
UNIFI_USERNAME=
UNIFI_PASSWORD=

# Site name or short name ("default" for single-site setups)
UNIFI_SITE=default

# Consoles ship with a self-signed certificate. Prefer pointing UNIFI_CA_CERT
# at the exported certificate; otherwise disable verification on a trusted LAN.
UNIFI_VERIFY_TLS=false
# UNIFI_CA_CERT=/path/to/unifi.pem

# true = only register read-only tools (no blocking, no firewall changes)
UNIFI_READ_ONLY=false

# JSONL log of every change made (default ~/.unifi-mcp/audit.log, "off" to disable)
# UNIFI_AUDIT_LOG=

# ---- MCP transport ----
# stdio (default for local `node dist/index.js`) or http (used by docker compose)
# MCP_TRANSPORT=http
# Required for http: clients send "Authorization: Bearer <token>". Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=
# HTTP listen address/port (compose sets these for you)
# MCP_HOST=127.0.0.1
# MCP_PORT=3000
# Comma-separated browser origins allowed to call the server (normally leave empty)
# MCP_ALLOWED_ORIGINS=
# docker compose only: host address the port is published on (default 127.0.0.1:3000; "3000" = all interfaces)
# MCP_PUBLISH=127.0.0.1:3000
